    {
      "id": 1791287692972.1711,
      "question": "The sum of the first n terms of a series is given by S<sub>n</sub> = 3n<sup>2</sup> + 2n. What is the 10th term?",
      "options": [
        "58",
        "59",
        "60",
        "61"
