  "questions": [
    {
      "id": 1795857681208.029,
      "question": "<div style='font-size: 1.2em; font-weight: 600;'>For <b>y = a<span style='vertical-align: super; font-size: 0.75em;'>x</span></b> with <b>a > 1</b>, the horizontal asymptote is:</div>",
      "options": [
        "y = 1",
        "x = 0",
        "y = 0",
        "x = 1"
      ],
      "correctAnswer": 2,
      "explanation": "For exponential functions of the form y = a<span style='vertical-align: super; font-size: 0.75em;'>x</span> where a > 1, as x approaches negative infinity (&minus;&infin;), the value of a<span style='vertical-align: super; font-size: 0.75em;'>x</span> approaches 0. Therefore, the graph gets closer and closer to the line y = 0 (the x-axis) but never touches it. The horizontal asymptote is <b>y = 0</b>.",
      "difficulty": "easy",
      "points": 1
    },
    {
      "id": 1795857681208.114,
      "question": "<div style='font-size: 1.2em; font-weight: 600;'>The y-intercept of <b>y = a<span style='vertical-align: super; font-size: 0.75em;'>x</span></b> is:</div>",
      "options": [
        "0",
        "1",
        "a",
