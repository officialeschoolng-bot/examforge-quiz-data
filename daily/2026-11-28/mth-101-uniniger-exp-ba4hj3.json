      "difficulty": "easy",
      "points": 1
    },
    {
      "id": 1795857681209.1956,
      "question": "<div style='font-size: 1.2em; font-weight: 600;'>Solve: <b>log<span style='vertical-align: sub; font-size: 0.75em;'>6</span>(x+9) = 1 + log<span style='vertical-align: sub; font-size: 0.75em;'>6</span>(x+3) &minus; log<span style='vertical-align: sub; font-size: 0.75em;'>6</span>(x+2)</b></div>",
      "options": [
