    {
      "id": 1795857681209.6543,
      "question": "<div style='font-size: 1.2em; font-weight: 600;'>Solve: <b>log<span style='vertical-align: sub; font-size: 0.75em;'>3</span>(4x+1) &minus; log<span style='vertical-align: sub; font-size: 0.75em;'>3</span>(3x&minus;5) = 2</b></div>",
